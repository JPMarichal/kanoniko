# EPUB working lot (inbox + archive + scratch). Files live on disk for the
# incorporation workflow (see docs/epub-incorporation.md) but are never
# tracked in git — they're binary, large, and provenance stays via the
# .meta.json under corpus/{lang}/{cat}/ plus the Fase 0 docs.
epub/!Ready/
epub/!Done/
epub/_preview/
epub/_smoke/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data — track everything except large generated backups
data/sqlite/alejandria.db
data/sqlite/alejandria.db.gz
data/sqlite/backups/
data/sqlite/neo4j_backups/
# Raw HTML scrapes (regeneratable via scripts/download_*.py)
data/raw/keil-delitzsch/
data/raw/gospelink/

# Gospelink Playwright session (cookies + storage)
data/.gospelink-session.json

# Docker / secrets
.env
docker/.env

# OS
Thumbs.db
.DS_Store

# Logs and temp output
logs/
rebuild-kg-output.txt

# Models (downloaded at build time)
models/

# Corporate CA certificates (machine-specific)
docker/ca-certificates.crt

# Corpus data (bind-mounted in Docker, tracked in git for backup/history)

# Large source assets (SQL dumps, etc.)
proj/**/recursos/
data/sqlite/alejandria.db

# Externo: sudario proyecto independiente clonado aparte
bibsud/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env.backup-*
epub/_imagen_pendientes/
epub/_review/

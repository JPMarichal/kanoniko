FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Inject corporate/custom CA certificates (for environments behind SSL-inspecting proxies)
COPY docker/ca-certificates.crt /usr/local/share/ca-certificates/corporate.crt
RUN update-ca-certificates
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Python deps — install in two layers for caching
COPY pyproject.toml ./

# GPU: Install PyTorch with CUDA support FIRST (before sentence-transformers pulls CPU version)
# Blackwell (sm_120) requires nightly/cu128 — stable cu126 maxes out at sm_90
RUN pip install --no-cache-dir --pre torch --index-url https://download.pytorch.org/whl/nightly/cu128

# Core deps
RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.0" \
    "pydantic-settings>=2.0" \
    "beautifulsoup4>=4.12.0" \
    "markdown-it-py>=3.0.0" \
    "aiofiles>=23.0"

# Semantic deps (will use the already-installed CUDA torch)
RUN pip install --no-cache-dir \
    "sentence-transformers>=3.0" \
    "sqlite-vec>=0.1.6"

# Graph + storage deps (Postgres IONOS + pgvector wire format)
RUN pip install --no-cache-dir \
    "psycopg[binary]>=3.1"

# MCP + CLI deps
RUN pip install --no-cache-dir \
    "click>=8.1" \
    "mcp>=1.0"

# Chat (RAG) deps
RUN pip install --no-cache-dir \
    "anthropic>=0.40" \
    "openai>=1.50" \
    "google-genai>=1.0"

# NER deps (spaCy + language models for entity auto-discovery)
RUN pip install --no-cache-dir "spacy>=3.7"
RUN python -m spacy download en_core_web_sm
RUN python -m spacy download es_core_news_sm

# Copy source and install package
COPY src/ ./src/
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
RUN pip install --no-cache-dir -e .

# Create data directories
RUN mkdir -p /app/data/sqlite

EXPOSE 4300

ENV ALEJANDRIA_HOST=0.0.0.0
ENV ALEJANDRIA_PORT=4300
ENV ALEJANDRIA_CORPUS_PATH=/app/corpus
ENV ALEJANDRIA_SQLITE_DB_PATH=/app/data/sqlite/alejandria.db
ENV ALEJANDRIA_EMBEDDING_DEVICE=cuda
# Postgres connection is provided via .env (ALEJANDRIA_POSTGRES_*).
# No Neo4j envs — the graph authoritative copy lives in Postgres IONOS.

CMD ["/app/entrypoint.sh"]

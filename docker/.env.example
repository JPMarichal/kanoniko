# Path to corpus on the host machine
ALEJANDRIA_CORPUS_PATH=../corpus

# Postgres IONOS (authoritative KG + chunks + embeddings).
# The default host points at the SSH tunnel bound on the host machine
# (see docs/ionos-setup.md). Override per-environment as needed.
ALEJANDRIA_POSTGRES_HOST=127.0.0.1
ALEJANDRIA_POSTGRES_PORT=15432
ALEJANDRIA_POSTGRES_DB=alejandria
ALEJANDRIA_POSTGRES_USER=alejandria_rw
ALEJANDRIA_POSTGRES_PASSWORD=
ALEJANDRIA_POSTGRES_SSLMODE=require

# LLM for RAG chat
# Provider: "anthropic" or "openai"
ALEJANDRIA_LLM_PROVIDER=anthropic
ALEJANDRIA_LLM_MODEL=claude-haiku-4-5-20251001
ALEJANDRIA_LLM_API_KEY=sk-ant-...your-key-here...
# ALEJANDRIA_LLM_BASE_URL=       # Only for OpenAI-compatible endpoints
# ALEJANDRIA_LLM_MAX_TOKENS=2048
# ALEJANDRIA_LLM_TEMPERATURE=0.3

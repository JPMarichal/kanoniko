{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alejandria.local/schemas/downloads.schema.json",
  "title": "DownloadsBacklog",
  "description": "Top-level array of raw-source-download state per slug.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slug"],
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
      },
      "source_url": {
        "type": "string",
        "format": "uri"
      },
      "skill": {
        "type": "string",
        "description": "Downloader name (gospelink, byu-studies, rsc-byu, manual, …)."
      },
      "raw_path": { "type": "string" },
      "sha256": {
        "type": "string",
        "pattern": "^([a-f0-9]{64}|)$"
      },
      "status": {
        "type": "string",
        "enum": ["pendiente", "descargado", "fallido"]
      },
      "error": { "type": "string" }
    }
  }
}
